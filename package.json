{
  "name": "@aimcram/agent",
  "version": "1.0.2",
  "description": "基于 DeepSeek Harness 的智能学习库生成 Agent（三模式：指定源 / 自主爬取 / 混合）",
  "type": "module",
  "main": "./dsh-plugin/index.mjs",
  "bin": {
    "aimcram-agent": "./cli.mjs"
  },
  "exports": {
    ".": "./dsh-plugin/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cli.mjs",
    "src/",
    "dsh-plugin/index.mjs",
    "cordis.patch.yml",
    "samples/",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "aimcram",
    "study-library",
    "kShare",
    "学习库"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "start": "node cli.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "doctor": "node cli.mjs doctor",
    "demo": "node cli.mjs generate --topic 系统架构设计 --source samples/architecture-notes.md --mock --out out"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "jsdom": "^27.0.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299"
  }
}
